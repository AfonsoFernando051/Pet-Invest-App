# Copy this file to `.env` (git-ignored) and fill in real values for local
# development. In CI/production, set these as real environment variables
# instead — `.env` is a local-dev convenience only. See DotenvLoader.

# HS256 signing key for JWTs — generate your own, e.g.: openssl rand -base64 48
jwt.secret=

# https://brapi.dev — leave blank to fall back to mock quote data locally.
api.brapi.token=

# https://libretranslate.com — leave blank to skip translation (content stays pt-BR).
api.libretranslate.key=

# https://ai.google.dev — powers the AI Investment Mentor chat (see docs/AI_MENTOR.md).
# Leave blank to get the mentor's friendly "I'm having trouble thinking" fallback reply.
api.gemini.key=
